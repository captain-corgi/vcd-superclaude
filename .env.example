# Application Configuration
APP_NAME=multi-agent-system
APP_VERSION=1.0.0
APP_DEBUG=true
APP_PORT=8080
APP_TIMEOUT=30s

# Database Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/multiagent?sslmode=disable
REDIS_URL=redis://localhost:6379

# Database Connection Pool Settings
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=5m

# Agent Configuration
PLANNER_MAX_REQUESTS=10
PLANNER_TIMEOUT=30s
EXECUTOR_RATE_LIMIT=100
EXECUTOR_RETRY_COUNT=3
EVALUATOR_CACHE_TTL=1h
EVALUATOR_MAX_REPORT_SIZE=10485760

# Google SSO Configuration
GOOGLE_CLIENT_ID=your-google-client-id.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Authentication Configuration (optional overrides)
AUTH_REDIRECT_BASE_URL=http://localhost:8080
AUTH_ALLOWED_DOMAINS=yourcompany.com,anotherdomain.com
AUTH_COOKIE_NAME=mas_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL=24h
AUTH_COOKIE_SAMESITE=lax

# External API Integrations
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret

SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

GITHUB_TOKEN=your-github-personal-access-token

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE=
LOG_DEVELOPMENT=true

# Datadog Configuration (optional)
DATADOG_ENABLED=false
DATADOG_SERVICE=
DATADOG_ENV=
DATADOG_VERSION=

# Audit Configuration
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=90
AUDIT_REDACT_KEYS=password,token,authorization,cookie,email

# Development Commands
# Setup: cp .env.example .env && make dev-setup
# Run: make dev
# Test: make test
# Build: make build
