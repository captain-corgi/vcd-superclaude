# Application Configuration
APP_NAME=multi-agent-system
APP_VERSION=1.0.0
APP_DEBUG=true
APP_PORT=8080
APP_TIMEOUT=30s

# Database Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/multiagent?sslmode=disable
REDIS_URL=redis://localhost:6379
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=5m

# Authentication Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTH_REDIRECT_BASE_URL=http://localhost:8080
AUTH_ALLOWED_DOMAINS=yourcompany.com,anothercompany.com
AUTH_COOKIE_NAME=mas_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TTL=24h

# CSRF Protection
AUTH_CSRF_SECRET=your-csrf-secret-key
AUTH_CSRF_COOKIE_NAME=csrf_token
AUTH_CSRF_COOKIE_SAMESITE=lax
AUTH_CSRF_TOKEN_LENGTH=32
AUTH_CSRF_TOKEN_TTL=1h

# Bootstrap Admin Emails (comma-separated)
AUTH_BOOTSTRAP_ADMIN_EMAILS=admin@yourcompany.com

# Communication Configuration
COMMUNICATION_A2A_PROTOCOL=trpc
COMMUNICATION_A2A_TIMEOUT=30s
COMMUNICATION_A2A_RETRIES=3
COMMUNICATION_A2A_SERVICE_TOKEN=your-service-token
COMMUNICATION_STREAMING_ENABLED=true
COMMUNICATION_STREAMING_BUFFER_SIZE=100

# Agent Configuration
PLANNER_MAX_REQUESTS=10
PLANNER_TIMEOUT=30s
EXECUTOR_RATE_LIMIT=100
EXECUTOR_RETRY_COUNT=3
EVALUATOR_CACHE_TTL=1h
EVALUATOR_MAX_REPORT_SIZE=10485760

# External Tool Configuration
JIRA_BASE_URL=https://yourcompany.atlassian.net
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
GITHUB_TOKEN=your-github-token

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE=

# Audit Configuration
AUDIT_ENABLED=true
AUDIT_EXPOSE_ENDPOINTS=true
AUDIT_RETENTION_DAYS=90
